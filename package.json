{
  "name": "guruagasthiya-web",
  "version": "7.7.0",
  "private": true,
  "description": "GuruAgasthiya as an installable, offline web app, imported from the Android APK.",
  "type": "module",
  "scripts": {
    "import": "node scripts/import-apk.mjs",
    "start": "node scripts/serve.mjs",
