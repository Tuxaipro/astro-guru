{
  "name": "guruagasthiya-web",
  "version": "11.2.0",
  "private": true,
  "description": "GuruAgasthiya as a website, imported from the Android app's page (APK or HTML release).",
  "type": "module",
  "scripts": {
    "import": "node scripts/import-apk.mjs",
    "build": "npm run import",
    "start": "node scripts/serve.mjs",
    "dev": "npm run build && npm start",
    "test": "node scripts/check-contract.mjs && node scripts/test-engine.mjs",
    "test:revamp": "node scripts/test-revamp.mjs",
    "test:pages": "node scripts/test-pages.mjs",
    "test:all": "npm test && npm run test:revamp && npm run test:pages"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "playwright-core": "^1.48.2"
  }
}
