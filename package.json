    "test:pages": "node scripts/test-pages.mjs",
    "test:all": "npm test && npm run test:pages"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "playwright-core": "^1.48.2"
  }
}
